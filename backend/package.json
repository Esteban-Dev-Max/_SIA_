{
  "name": "sia-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "migrate": "node migrate.js",
    "seed": "node seed.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:setup": "cross-env DB_NAME=academico_test node tests/setup-db.js",
    "test:seed": "cross-env DB_NAME=academico_test node tests/seed-test.js",
    "test:integration": "cross-env DB_NAME=academico_test node --test tests/integration/*.test.js",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2"
  }
}
